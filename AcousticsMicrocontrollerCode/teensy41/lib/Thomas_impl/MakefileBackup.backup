# Compiler
CC = arm-none-eabi-g++

# Directories
SRC_DIR = .
OBJ_DIR = .

INCLUDE := $(shell find . -type f -name '*.h')
#SRC := $(shell find . -type f -name '*.c')
OBJ = $(SRC:.c=.o)
#HEX = $(PROJECT).hex

INCLUDE_DIRS = -I$(SRC_DIR) -I /home/thomas/acoustics_ws/src/vortex-acoustics/AcousticsMicrocontrollerCode/teensy41/lib/Include


# Create the build directory if it does not exist
$(shell mkdir -p $(OBJ_DIR))

# Source files
SRCS = main.cpp corelation.cpp tdoa.cpp
OBJS = $(patsubst %.cpp, $(OBJ_DIR)/%.o, $(SRCS))

# Compiler flags
CFLAGS = -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=softfp -Wall -O2 $(INCLUDE_DIRS)
LDFLAGS = -mcpu=cortex-m7 $(INCLUDE_DIRS)

# Output binary
TARGET = thomas_impl.elf

# Default target
all: $(TARGET)


# Compile source files into object files
$(OBJ_DIR)/%.o: %.cpp
	$(CC) $(CFLAGS) -c $< -o $@

# Link the executable
$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) $< -o $@

compile: $(SRC)
	$(CC) $(CFLAGS) -c $^ -o $@

# Clean build artifacts
clean:
	rm -rf $(OBJ_DIR) $(TARGET)
